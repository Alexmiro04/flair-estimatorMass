<!DOCTYPE remote_ui_xml>
<root name="Drone_0">
 <TabWidget name="Main_TabWidget">
  <Tab name="motors">
   <TabWidget name="UavMultiplex">
    <Tab name="Setup">
     <GroupBox name="x4 multiplex">
      <ComboBox value="0" name="front left blade pitch:"/>
     </GroupBox>
     <DoubleSpinBox value="0" name="permanent trim roll"/>
     <DoubleSpinBox value="0" name="permanent trim pitch"/>
     <GroupBox name="motor attribution">
      <ComboBox value="0" name="front left"/>
      <ComboBox value="1" name="front rigth"/>
      <ComboBox value="2" name="rear left"/>
      <ComboBox value="3" name="rear rigth"/>
     </GroupBox>
     <GroupBox name="bldc">
      <Label name="flight time"/>
      <DoubleSpinBox value="0.4" name="min value:"/>
      <DoubleSpinBox value="1" name="max value:"/>
      <DoubleSpinBox value="0.1" name="test value:"/>
      <SpinBox value="2" name="test duration:"/>
      <PushButton value="0" name="test motor 0"/>
      <PushButton value="0" name="test motor 1"/>
      <PushButton value="0" name="test motor 2"/>
      <PushButton value="0" name="test motor 3"/>
      <PushButton value="0" name="test selected motors"/>
      <CheckBox value="1" name="0"/>
      <CheckBox value="1" name="1"/>
      <CheckBox value="1" name="2"/>
      <CheckBox value="1" name="3"/>
     </GroupBox>
     <GroupBox name="simubldc">
      <DoubleSpinBox value="86" name="k driver:"/>
     </GroupBox>
    </Tab>
    <Tab name="Values">
     <DataPlot1D name="front left"/>
     <DataPlot1D name="front right"/>
     <DataPlot1D name="rear left"/>
     <DataPlot1D name="rear right"/>
    </Tab>
    <Tab name="Speeds">
     <DataPlot1D name="front left"/>
     <DataPlot1D name="front right"/>
     <DataPlot1D name="rear left"/>
     <DataPlot1D name="rear right"/>
    </Tab>
   </TabWidget>
  </Tab>
  <Tab name="us">
   <TabWidget name="us">
    <Tab name="Reglages">
     <GroupBox name="us">
      <SpinBox value="50" name="data rate"/>
     </GroupBox>
     <GroupBox name="Passe bas">
      <DoubleSpinBox value="0" name="period, 0 for auto"/>
      <DoubleSpinBox value="5" name="cutoff frequency"/>
     </GroupBox>
     <GroupBox name="Vz">
      <DoubleSpinBox value="0" name="period, 0 for auto:"/>
      <DoubleSpinBox value="-1" name="saturation, -1 to disable:"/>
     </GroupBox>
     <GroupBox name="Passe bas v">
      <DoubleSpinBox value="0" name="period, 0 for auto"/>
      <DoubleSpinBox value="5" name="cutoff frequency"/>
     </GroupBox>
    </Tab>
    <Tab name="Mesures">
     <DataPlot1D name="us"/>
     <DataPlot1D name="vz"/>
    </Tab>
   </TabWidget>
  </Tab>
  <Tab name="imu">
   <TabWidget name="imu">
    <Tab name="Reglages">
     <GroupBox name="imu">
      <SpinBox value="200" name="data rate"/>
     </GroupBox>
    </Tab>
    <Tab name="AHRS">
     <DataPlot1D name="roll"/>
     <DataPlot1D name="pitch"/>
     <DataPlot1D name="yaw"/>
     <DataPlot1D name="w_x"/>
     <DataPlot1D name="w_y"/>
     <DataPlot1D name="w_z"/>
    </Tab>
    <Tab name="Quaternion">
     <DataPlot1D name="q0"/>
     <DataPlot1D name="q1"/>
     <DataPlot1D name="q2"/>
     <DataPlot1D name="q3"/>
    </Tab>
    <Tab name="IMU">
     <DataPlot1D name="acc_x"/>
     <DataPlot1D name="acc_y"/>
     <DataPlot1D name="acc_z"/>
     <DataPlot1D name="gyr_x"/>
     <DataPlot1D name="gyr_y"/>
     <DataPlot1D name="gyr_z"/>
     <DataPlot1D name="mag_x"/>
     <DataPlot1D name="mag_y"/>
     <DataPlot1D name="mag_z"/>
    </Tab>
   </TabWidget>
  </Tab>
  <Tab name="battery">
   <GroupBox name="battery">
    <Label name="battery"/>
    <DoubleSpinBox value="10" name="threshold"/>
    <SpinBox value="10" name="threshold time"/>
   </GroupBox>
  </Tab>
  <Tab name="Dualshock3">
   <TabWidget name="Dualshock3">
    <Tab name="Reglages">
     <GroupBox name="consignes joy">
      <DoubleSpinBox value="-20" name="debattement roll"/>
      <DoubleSpinBox value="-20" name="debattement pitch"/>
      <DoubleSpinBox value="90" name="debattement wz"/>
      <DoubleSpinBox value="-0.7" name="debattement dz"/>
      <DoubleSpinBox value="0" name="trim"/>
      <GroupBox name="trim roll">
       <Label name="value"/>
       <PushButton value="0" name="up"/>
       <PushButton value="0" name="down"/>
       <PushButton value="0" name="reset"/>
      </GroupBox>
      <GroupBox name="trim pitch">
       <Label name="value"/>
       <PushButton value="0" name="up"/>
       <PushButton value="0" name="down"/>
       <PushButton value="0" name="reset"/>
      </GroupBox>
     </GroupBox>
    </Tab>
   </TabWidget>
  </Tab>
  <Tab name="uav">
   <GridLayout name="buttons">
    <PushButton value="0" name="quit program"/>
    <PushButton value="0" name="start_log"/>
    <PushButton value="0" name="stop_log"/>
    <PushButton value="0" name="take_off"/>
    <PushButton value="0" name="land"/>
    <PushButton value="0" name="start_circle"/>
    <PushButton value="0" name="stop_circle"/>
    <PushButton value="0" name="position hold"/>
    <GroupBox name="Control mode">
     <PushButton value="0" name="Activate"/>
     <PushButton value="0" name="Deactivate"/>
     <ComboBox value="1" name="Control selection"/>
    </GroupBox>
    <GroupBox name="Custom task">
     <ComboBox value="1" name="Custom task"/>
     <Vector3DSpinBox value_x="-2.000" value_y="3.000" value_z="0.000" name="Desired position"/>
     <DoubleSpinBox value="0" name="Desired yaw"/>
    </GroupBox>
   </GridLayout>
   <GroupBox name="takeoff/landing">
    <DoubleSpinBox value="1" name="desired takeoff altitude"/>
    <DoubleSpinBox value="0" name="desired landing altitude"/>
   </GroupBox>
   <GroupBox name="alt cons">
    <DoubleSpinBox value="0" name="period, 0 for auto:"/>
    <DoubleSpinBox value="0.5" name="velocity max (absolute):"/>
    <DoubleSpinBox value="0.2" name="acceleration (absolute):"/>
   </GroupBox>
  </Tab>
  <Tab name="control laws">
   <TabWidget name="laws">
    <Tab name="Setup">
     <GroupBox name="u_roll">
      <DoubleSpinBox value="15" name="sat ref:"/>
      <DoubleSpinBox value="15" name="kp:"/>
      <DoubleSpinBox value="100" name="sat dref:"/>
      <DoubleSpinBox value="0.1" name="kd:"/>
      <DoubleSpinBox value="0.5" name="sat u:"/>
     </GroupBox>
     <GroupBox name="u_pitch">
      <DoubleSpinBox value="15" name="sat ref:"/>
      <DoubleSpinBox value="15" name="kp:"/>
      <DoubleSpinBox value="100" name="sat dref:"/>
      <DoubleSpinBox value="0.1" name="kd:"/>
      <DoubleSpinBox value="0.5" name="sat u:"/>
     </GroupBox>
     <GroupBox name="u_yaw">
      <DoubleSpinBox value="0" name="period, 0 for auto"/>
      <DoubleSpinBox value="1" name="kp:"/>
      <DoubleSpinBox value="0" name="ki:"/>
      <DoubleSpinBox value="0" name="sat i:"/>
      <DoubleSpinBox value="0.1" name="kd:"/>
      <DoubleSpinBox value="0.2" name="sat:"/>
     </GroupBox>
     <GroupBox name="u_z">
      <DoubleSpinBox value="0" name="period, 0 for auto"/>
      <DoubleSpinBox value="0.3" name="kp:"/>
      <DoubleSpinBox value="0.2" name="ki:"/>
      <DoubleSpinBox value="0.5" name="sat i:"/>
      <DoubleSpinBox value="0.1" name="kd:"/>
      <DoubleSpinBox value="0.6" name="offset g:"/>
      <DoubleSpinBox value="1" name="sat:"/>
      <DoubleSpinBox value="0.0002" name="offset step:"/>
     </GroupBox>
     <GroupBox name="u_x">
      <DoubleSpinBox value="0" name="period, 0 for auto"/>
      <DoubleSpinBox value="0.2" name="kp:"/>
      <DoubleSpinBox value="0" name="ki:"/>
      <DoubleSpinBox value="0" name="sat i:"/>
      <DoubleSpinBox value="0.2" name="kd:"/>
      <DoubleSpinBox value="1" name="sat:"/>
     </GroupBox>
     <GroupBox name="u_y">
      <DoubleSpinBox value="0" name="period, 0 for auto"/>
      <DoubleSpinBox value="0.2" name="kp:"/>
      <DoubleSpinBox value="0" name="ki:"/>
      <DoubleSpinBox value="0" name="sat i:"/>
      <DoubleSpinBox value="0.2" name="kd:"/>
      <DoubleSpinBox value="1" name="sat:"/>
     </GroupBox>
    </Tab>
    <Tab name="Graphes">
     <DataPlot1D name="u_roll"/>
     <DataPlot1D name="u_pitch"/>
     <DataPlot1D name="u_yaw"/>
     <DataPlot1D name="u_z"/>
     <DataPlot1D name="u_x"/>
     <DataPlot1D name="u_y"/>
    </Tab>
   </TabWidget>
  </Tab>
  <Tab name="vrpn">
   <TabWidget name="vrpn">
    <Tab name="Reglages">
     <GroupBox name="post rotation 1">
      <DoubleSpinBox value="0" name="value"/>
      <ComboBox value="0" name="axis"/>
     </GroupBox>
     <GroupBox name="post rotation 2">
      <DoubleSpinBox value="0" name="value"/>
      <ComboBox value="0" name="axis"/>
     </GroupBox>
     <GroupBox name="Drone_0 Passe bas">
      <DoubleSpinBox value="0" name="period, 0 for auto"/>
      <DoubleSpinBox value="2" name="cutoff frequency"/>
     </GroupBox>
     <GroupBox name="Drone_0_euler">
      <DoubleSpinBox value="0" name="period, 0 for auto:"/>
      <DoubleSpinBox value="-1" name="saturation, -1 to disable:"/>
     </GroupBox>
     <GroupBox name="target Passe bas">
      <DoubleSpinBox value="0" name="period, 0 for auto"/>
      <DoubleSpinBox value="2" name="cutoff frequency"/>
     </GroupBox>
     <GroupBox name="target_euler">
      <DoubleSpinBox value="0" name="period, 0 for auto:"/>
      <DoubleSpinBox value="-1" name="saturation, -1 to disable:"/>
     </GroupBox>
     <GroupBox name="circle">
      <DoubleSpinBox value="0" name="period, 0 for auto"/>
      <DoubleSpinBox value="1.5" name="R"/>
      <DoubleSpinBox value="1" name="velocity"/>
      <DoubleSpinBox value="0.1" name="acceleration (absolute)"/>
     </GroupBox>
    </Tab>
    <Tab name="Mesures Drone_0">
     <DataPlot1D name="x"/>
     <DataPlot1D name="y"/>
     <DataPlot1D name="z"/>
     <DataPlot1D name="vx"/>
     <DataPlot1D name="vy"/>
     <DataPlot1D name="vz"/>
    </Tab>
    <Tab name="Mesures (xy) Drone_0">
     <DataPlot2D name="xy"/>
    </Tab>
    <Tab name="Mesures target">
     <DataPlot1D name="x"/>
     <DataPlot1D name="y"/>
     <DataPlot1D name="z"/>
     <DataPlot1D name="vx"/>
     <DataPlot1D name="vy"/>
     <DataPlot1D name="vz"/>
    </Tab>
    <Tab name="Mesures (xy) target">
     <DataPlot2D name="xy"/>
    </Tab>
   </TabWidget>
  </Tab>
  <Tab name="Custom controller">
   <GroupBox name="PID controller">
    <GroupBox name="General parameters">
     <DoubleSpinBox value="0" name="Custom dt [s]"/>
     <DoubleSpinBox value="1.200" name="Mass [kg]"/>
     <DoubleSpinBox value="7.000" name="Motor constant"/>
     <DoubleSpinBox value="0.201" name="Saturation pos"/>
     <DoubleSpinBox value="0.8" name="Saturation att"/>
     <DoubleSpinBox value="1" name="Saturation thrust"/>
     <DoubleSpinBox value="0.256" name="Km adaptation"/>
    </GroupBox>
    <GroupBox name="Custom position controller">
     <Vector3DSpinBox value_x="2.00" value_y="2.50" value_z="2.000" name="Kp_pos"/>
     <Vector3DSpinBox value_x="1.0" value_y="1.5" value_z="1.000" name="Kd_pos"/>
     <Vector3DSpinBox value_x="0" value_y="0" value_z="0" name="Ki_pos"/>
    </GroupBox>
    <GroupBox name="Custom attitude controller">
     <Vector3DSpinBox value_x="15" value_y="15" value_z="1" name="Kp_att"/>
     <Vector3DSpinBox value_x="0.5" value_y="0.5" value_z="0.1" name="Kd_att"/>
     <Vector3DSpinBox value_x="0" value_y="0" value_z="0" name="Ki_att"/>
    </GroupBox>
    <DataPlot1D name="Mass Estimation"/>
    <DataPlot1D name="Error Estimation"/>
    <PushButton value="0" name="Reset Mass Estimation"/>
   </GroupBox>
  </Tab>
 </TabWidget>
 <PushButton value="0" name="save config on target (Drone_0)"/>
</root>
